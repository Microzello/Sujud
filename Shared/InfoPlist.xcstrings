{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sujud"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sujud"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Location permission prompt (macOS)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم سجود موقعك لحساب مواقيت الصلاة واتجاه القبلة. يبقى موقعك على أجهزتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নামাজের সময় ও কিবলার দিক নির্ণয় করতে সুজুদ আপনার অবস্থান ব্যবহার করে। আপনার অবস্থান আপনার ডিভাইসগুলোতেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud verwendet deinen Standort, um die Gebetszeiten und die Qibla-Richtung zu berechnen. Dein Standort bleibt auf deinen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sujud uses your location to calculate prayer times and the Qibla direction. Your location stays on your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud usa tu ubicación para calcular los horarios de oración y la dirección de la qibla. Tu ubicación se queda en tus dispositivos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سجود از موقعیت شما برای محاسبهٔ اوقات شرعی و جهت قبله استفاده می‌کند. موقعیت شما فقط روی دستگاه‌های خودتان می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud utilise votre position pour calculer les heures de prière et la direction de la qibla. Votre position reste sur vos appareils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud menggunakan lokasi Anda untuk menghitung waktu salat dan arah kiblat. Lokasi Anda tetap berada di perangkat Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud menggunakan lokasi anda untuk mengira waktu solat dan arah kiblat. Lokasi anda kekal pada peranti anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud использует вашу геопозицию, чтобы рассчитать время намаза и направление киблы. Ваша геопозиция остаётся на ваших устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujud, namaz vakitlerini ve kıble yönünü hesaplamak için konumunuzu kullanır. Konumunuz cihazlarınızda kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سجود نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام استعمال کرتا ہے۔ آپ کا مقام آپ کے آلات پر ہی رہتا ہے۔"
          }
        }
      }
    },
