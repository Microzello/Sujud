    "Sujud needs your location to calculate prayer times and the Qibla direction. Your location never leaves your device." : {
      "comment" : "Explanation shown when location permission is denied",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج سجود إلى موقعك لحساب مواقيت الصلاة واتجاه القبلة. لا يغادر موقعك جهازك أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নামাজের সময় ও কিবলার দিক নির্ণয় করতে সুজুদের আপনার অবস্থান প্রয়োজন। আপনার অবস্থান কখনো আপনার ডিভাইসের বাইরে যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud benötigt deinen Standort, um die Gebetszeiten und die Qibla-Richtung zu berechnen. Dein Standort verlässt niemals dein Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud necesita tu ubicación para calcular los horarios de oración y la dirección de la qibla. Tu ubicación nunca sale de tu dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجود برای محاسبهٔ اوقات شرعی و جهت قبله به موقعیت شما نیاز دارد. موقعیت شما هرگز از دستگاهتان خارج نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud a besoin de votre position pour calculer les heures de prière et la direction de la qibla. Votre position ne quitte jamais votre appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud memerlukan lokasi Anda untuk menghitung waktu salat dan arah kiblat. Lokasi Anda tidak pernah meninggalkan perangkat Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud memerlukan lokasi anda untuk mengira waktu solat dan arah kiblat. Lokasi anda tidak pernah meninggalkan peranti anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud нужна ваша геопозиция, чтобы рассчитать время намаза и направление киблы. Ваша геопозиция никогда не покидает устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujud, namaz vakitlerini ve kıble yönünü hesaplamak için konumunuza ihtiyaç duyar. Konumunuz asla cihazınızdan çıkmaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجود کو نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام درکار ہے۔ آپ کا مقام کبھی آپ کے آلے سے باہر نہیں جاتا۔"
          }
        }
      }
    },
