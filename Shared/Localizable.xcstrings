        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরবর্তী নামাজ পর্যন্ত কাউন্টডাউন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt bis zum nächsten Gebet herunter."
